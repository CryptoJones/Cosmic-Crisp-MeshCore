// MeshCoreUSBUserClient.iig — external methods the app calls.

#ifndef MeshCoreUSBUserClient_h
#define MeshCoreUSBUserClient_h

#include <DriverKit/IOUserClient.iig>

class MeshCoreUSBUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector, IOUserClientMethodArguments *arguments,
                                         const IOUserClientMethodDispatch *dispatch, OSObject *target,
                                         void *reference) override;

    // Async callback into the app carrying inbound bytes.
    virtual void DeliverBytes(OSAction *action, const void *bytes, size_t length) LOCALONLY;
};

#endif
